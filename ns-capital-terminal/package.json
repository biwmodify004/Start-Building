{
  "name": "ns-capital-terminal",
  "version": "1.9.0",
  "private": true,
  "type": "module",
  "description": "NS Capital Terminal, a personal charting and strategy research workspace powered by Vela.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "start": "node scripts/serve.mjs",
    "test:python": "python -W error::ResourceWarning -m unittest discover -s tests -p 'test_*.py' -q",
    "build:pages": "node scripts/build-pages.mjs"
  },
  "dependencies": {
    "@luxalgo/vela": "0.8.4"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "jsdom": "26.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
